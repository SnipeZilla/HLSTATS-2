use strict;

our ($g_version, %g_eventTables, $dbh, $db_driver, $db_name, $db_host, $db_user, $db_pass, $s_addr, $g_stdin, $g_debug);

# HLstatsZ release version number
$g_version = "2.5.22";

my %stmt_cache = ();
%g_eventTables = (
    "TeamBonuses",
        ["playerId", "actionId", "bonus"],
    "ChangeRole",
        ["playerId", "role"],
    "ChangeName",
        ["playerId", "oldName", "newName"],
    "ChangeTeam",
        ["playerId", "team"],
    "Connects",
        ["playerId", "ipAddress"],
    "Disconnects",
        ["playerId"],
    "Entries",
        ["playerId"],
    "Frags",
        ["killerId", "victimId", "weapon", "headshot", "killerRole", "victimRole", "pos_x","pos_y","pos_z", "pos_victim_x","pos_victim_y","pos_victim_z"],
    "PlayerActions",
        ["playerId", "actionId", "bonus", "pos_x","pos_y","pos_z"],
    "PlayerPlayerActions",
        ["playerId", "victimId", "actionId", "bonus", "pos_x","pos_y","pos_z", "pos_victim_x","pos_victim_y","pos_victim_z"],
    "Suicides",
        ["playerId", "weapon", "pos_x","pos_y","pos_z"],
    "Teamkills",
        ["killerId", "victimId", "weapon", "pos_x","pos_y","pos_z", "pos_victim_x","pos_victim_y","pos_victim_z"],
    "Rcon",
        ["type", "remoteIp", "password", "command"],
    "Admin",
        ["type", "message", "playerName"],
    "Statsme",
        ["playerId", "weapon", "shots", "hits", "headshots", "damage", "kills", "deaths"],
    "Statsme2",
        ["playerId", "weapon", "head", "chest", "stomach", "leftarm", "rightarm", "leftleg", "rightleg"],
    "StatsmeLatency",
        ["playerId", "ping"],
    "StatsmeTime",
        ["playerId", "time"],
    "Chat",
        ["playerId", "message_mode", "message"]
);


####################################
#         Common Functions         #
####################################

#
# string utf8_text (string text)
#
# Text a game server sent (a chat line, a name, a clan tag) as a Perl character string, ready for the database
# (DBD::mysql with mysql_enable_utf8mb4 encodes it once): its UTF-8 bytes decoded.
#

sub utf8_text
{
    my ($text) = @_;
    return $text unless defined $text && length $text;

    if (Encode::is_utf8($text)) {
        return $text if $text =~ /[^\x00-\xFF]/;    # characters past U+00FF: decoded already
        return $text unless $text =~ /[\x80-\xFF]/; # ASCII
        my $bytes = $text;
        utf8::downgrade($bytes, 1) or return $text;
        my $copy    = $bytes;
        my $decoded = eval { Encode::decode('UTF-8', $copy, Encode::FB_CROAK()) };
        # Not UTF-8 ("Café" as decoded Latin-1 text): it was text already
        return defined $decoded ? $decoded : $text;
    }
    return Encode::decode('UTF-8', $text, Encode::FB_DEFAULT());
}

sub quote_sql {
    my ($val) = @_;
    return "NULL" unless defined $val;
    $val =~ s/\\/\\\\/g;   # replace \ with \\
    $val =~ s/'/\\'/g;     # replace ' with \'
    return "'$val'";
}

sub number_format {
  local $_  = shift;
  1 while s/^(-?\d+)(\d{3})/$1,$2/;
  return $_;
}

sub date_format {
  my $timestamp = shift;
  return sprintf('%d hours and %d minutes', 
                  $timestamp / 3600, 
                  $timestamp / 3600 % 60
                 );
}

####################################
#         Connect to MySql         #
####################################

sub DB_connect {
    return if $dbh && $dbh->ping;

    my $dsn = $db_driver eq 'mariadb'
              ? "DBI:MariaDB:database=$db_name;host=$db_host"
              : "DBI:mysql:database=$db_name;host=$db_host";

    for my $attempt (1 .. 3) {
        eval {
            $dbh = DBI->connect(
                $dsn, $db_user, $db_pass,
                {
                    RaiseError           => 0,
                    PrintError           => 1,
                    AutoCommit           => 1,
                    ($db_driver eq 'mysql' ? (
                        mysql_enable_utf8mb4   => 1,
                        mysql_auto_reconnect   => 1,
                    ) : ( mariadb_auto_reconnect => 1,))
                }
            );
        };

        if ($dbh) {
            $dbh->do("SET NAMES utf8mb4 COLLATE utf8mb4_general_ci") unless $db_driver eq 'mariadb';
            printEvent("MYSQL", "Connected to '$db_name' on '$db_host' as '$db_user' with $db_driver", 1);
            %stmt_cache = ();
            return 1;
        }

        printEvent("MYSQL", "Connection attempt $attempt failed: $DBI::errstr", 1);
        sleep(5);
    }
    die "Failed to connect to DB after 3 attempts.";
    }

# The statement that just failed was not run because the connection to the server is lost
sub db_lost {
    my $err = $DBI::err // 0;
    # cannot connect, server gone, connection lost, server shutting down, connection killed, closed for inactivity
    return scalar grep { $err == $_ } 2002, 2003, 2006, 2013, 2055, 1053, 1927, 4031;
}


sub query_now {
    my ($sql, @bind) = @_;

    my $sth = $dbh->prepare($sql);
    unless ($sth) {
        printEvent("MYSQL", "Prepare failed:\n$sql\n$DBI::errstr", 1);
        return;
    }
    if (!$sth->execute(@bind) && db_lost()) {
        # Once more when the connection is back
        DB_connect();
        $sth = $dbh->prepare($sql) or return;
        $sth->execute(@bind);
    }
    return $sth
}

sub exec_now {
    my ($sql, @bind) = @_;
    my $rows = $dbh->do($sql, undef, @bind);
    if (!defined $rows && db_lost()) {
        # Once more when the connection is back
        DB_connect();
        $rows = $dbh->do($sql, undef, @bind);
    }
    return $rows;
}


sub exec_cache {
    my ($query_id, $sql, @bind) = @_;

    unless ($stmt_cache{$query_id}) {
        $stmt_cache{$query_id} = $dbh->prepare($sql);
        unless ($stmt_cache{$query_id}) {
            printEvent("MYSQL", "Prepare failed ($query_id):\n$sql\n$DBI::errstr", 1);
            return;
        }
    }

    unless ($stmt_cache{$query_id}->execute(@bind)) {
        my $lost = db_lost();
        printEvent("MYSQL", "Execute failed ($query_id):\n$sql\n$DBI::errstr", 1);
        printEvent("MYSQL", print join(', ', @bind), 1);
        delete $stmt_cache{$query_id};
        # Once more when the connection is back
        DB_connect() if $lost;

        $stmt_cache{$query_id} = $dbh->prepare($sql);
        if ($stmt_cache{$query_id} && $stmt_cache{$query_id}->execute(@bind)) {
            return $stmt_cache{$query_id};
        }

        printEvent("MYSQL", "Retry failed for ($query_id)", 1);
        return;
    }

    return $stmt_cache{$query_id};
}

#
# void doConf (object conf, hash directives)
#
# Walk through configuration directives, setting values of global variables.
#

sub doConf
{
    my ($conf, %directives) = @_;
    no strict 'refs';    # each directive names the global variable it sets
    
    while (my ($directive, $variable) = each(%directives))
    {
        if ($directive eq "Servers") {
           %$variable = $conf->get($directive);
        } else {
            $$variable = $conf->get($directive);
        }
    }

}

#
# void setOptionsConf (hash optionsconf)
#
# Walk through configuration directives, setting values of global variables.
#

sub setOptionsConf
{
    my (%optionsconf) = @_;
    no strict 'refs';    # each option names the global variable it sets
    
    while (my ($thekey, $theval) = each(%optionsconf))
    {
        if($theval)
        {
              $$thekey = $theval;
        }
    }

}

#
# string abbreviate (string thestring[, int maxlength)
#
# Returns thestring abbreviated to maxlength-3 characters plus "...", unless
# thestring is shorter than maxlength.
#

sub abbreviate
{
    my ($thestring, $maxlength) = @_;
    
    $maxlength = 12  unless ($maxlength);
    
    if (length($thestring) > $maxlength)
    {
        $thestring = substr($thestring, 0, $maxlength - 3);
        return "$thestring...";
    }
    else
    {
        return $thestring;
    }
}

#
# Logs event information to stdout.
#
my @DBGQ;
my $DBG_MAX       = 20000;
my $FLUSH_EVERY   = 0.05;
my $FLUSH_LINES   = 500;
my $last_flush    = time();

my $last_ts_sec = -1;
my $last_ts_str = '';

sub _ts_cached {
    my $sec = time();
    $sec = int($sec);
    if ($sec != $last_ts_sec) {
        my ($s,$m,$h,$d,$mo,$y) = localtime($sec);
        $last_ts_str = sprintf(
            "%04d-%02d-%02d %02d:%02d:%02d",
            $y+1900, $mo+1, $d, $h, $m, $s
        );
        $last_ts_sec = $sec;
    }
    return $last_ts_str;
}

sub _dbg_flush {
    return unless @DBGQ;
    print STDOUT join('', @DBGQ);
    @DBGQ = ();
    $last_flush = time();
}

sub printEvent
{
    my ($code, $description, $level, $addr) = @_;
    $addr //= $s_addr;
    return unless (
        ($g_stdin == 0 && $g_debug > 0 &&
            ($g_debug == 9 || $level == 1 || $g_debug == $level))
        || ($g_stdin == 1 && $level == 1)
    );

    my $line;
    if ($level == 2) {
        $line = "$code - $description\n";
    } else {
        my $timestamp = _ts_cached();
        $line = sprintf("%s %21s - %s: %s\n", $timestamp, $addr, $code, $description);
    }

    push @DBGQ, $line;

    if (@DBGQ > $DBG_MAX) {
        splice(@DBGQ, 0, int($DBG_MAX / 2));
    }

    if (@DBGQ >= $FLUSH_LINES) {
        _dbg_flush();
        return;
    }

    my $now = time();
    if (($now - $last_flush) >= $FLUSH_EVERY) {
        _dbg_flush();
    }
}

1;
